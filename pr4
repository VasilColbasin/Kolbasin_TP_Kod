from tkinter import Tk, Frame, Canvas, BOTH, Label, Entry
from tkinter.ttk import Style, Button
import math
import copy
import re

student = 70205273
class TowerOfHanoi:
    def __init__(self, student):
        # y первоначальное значение id студента без преобразований '70186274'
        # y создаём нулевой шпиндель и реверс с 8 по 1
        self.id_student = list(reversed(student + '0'))
        self.spindles =  self.updating_disks()
        self.counter = 0 # y начальное значение счетчика перемещений дисков
        self.percentage_counter = None # y номер итерации от % выполнения
        self.tmp_value = None

    def updating_disks(self): # r обновляем список дисков
        self.spindles = [self.create_disks(i, int(j)) for i, j in enumerate(self.id_student)]  # y список дисков на шпинделях
        return self.spindles

    @staticmethod
    def create_disks(spindle_number, disk_number):
        return [spindle_number * 10 + i for i in range(disk_number, 0, -1)]

    def move_disk(self, source, target):
        # r фактическое перемещение диска
        if self.spindles[source]:
            disk = self.spindles[source][-1]
            if (not self.spindles[target] or self.spindles[target][
                -1] > disk):
                self.spindles[target].append(self.spindles[source].pop())
                self.counter += 1 # y вкл счетчик итераций

                # y если % от max количества итераций целое число
                if self.counter == self.percentage_counter:
                    # y Сохраняем копию списка дисков
                    self.tmp_value = [copy.deepcopy(self.spindles), disk,
                                      source, target]

            else: # y Ошибка перемещения диска
                logger.debug(f"Cannot move disk {disk} from spindle {source} to spindle {target}")

    def hanoi_recursive(self, n, source, target, auxiliary):
        # r алгоритм ханойских башен
        if n == 0:
            return
        self.hanoi_recursive(n - 1, source, auxiliary, target)
        self.move_disk(source, target)
        self.hanoi_recursive(n - 1, auxiliary, target, source)

    def source_disks(self, item): # r количество дисков у исходного шпинделя
        return len(self.spindles[item])

    def go(self): # r вывод конечного списка расположения дисков
        # y Перемещения между шпинделями
        moves = [
            (1, 2, 3), (2, 1, 3), (3, 4, 2), (4, 3, 5),
            (5, 6, 4), (6, 5, 7), (7, 8, 6), (8, 7, 6),
            (7, 6, 8), (5, 6, 4), (6, 7, 5), (7, 8, 6),
            (6, 5, 7), (5, 4, 6), (3, 4, 2), (4, 5, 3),
            (5, 4, 6), (4, 5, 3), (5, 6, 4), (4, 3, 5),
            (1, 3, 2), (3, 4, 2), (4, 5, 3), (3, 2, 4),
            (2, 1, 3), (5, 4, 6), (6, 5, 7), (8, 6, 7),
            (4, 3, 5), (5, 6, 4), (6, 7, 5), (7, 8, 6),
            (6, 5, 7), (5, 4, 6), (3, 4, 2), (4, 5, 3),
            (5, 6, 4), (4, 3, 5), (3, 2, 4), (2, 1, 3),
            (6, 5, 7), (8, 6, 7), (5, 6, 4), (6, 7, 5),
            (7, 8, 6), (6, 5, 7), (5, 4, 6), (4, 3, 5),
            (3, 2, 4), (2, 1, 3), (8, 6, 7), (6, 5, 7),
            (5, 4, 6), (4, 3, 5), (3, 2, 4), (2, 1, 3)
        ]
        temp_var = 0 # y  сохраняю количество дисков для дальнейшей переброски
        # y  этих же дисков на другом шпинделе с другим количеством дисков

        for i, move in enumerate(moves):
            # y если вычисленная итерация, не None, то выходим из цикла
            if self.percentage_counter and self.counter >= self.percentage_counter:
                # logger.debug(f'Остановка на итерации {self.counter}')
                break
            # y на определенных позициях сохраняю количество дисков в temp_var
            if i in (9, 14, 16, 20, 29, 34, 42):
                temp_var = self.source_disks(move[0])
            # y использую переменную temp_var для проброски нужного
            #  количества дисков на другой шпиндель
            if i in (10, 15, 17, 21, 30, 35, 43):
                self.hanoi_recursive(temp_var, move[0], move[1], move[2])
                continue
            n = self.source_disks(move[0])
            self.hanoi_recursive(n, move[0], move[1], move[2])
        return self.spindles


class CanvasForHanoiTowers(Frame):
    # y начальные точки отсчета дисков
    POINTS = [[], [770, 725], [675, 725], [580, 725], [485, 725], [390, 725],
    [295, 725], [200, 725], [105, 725]]
    # y цвета дисков
    COLORS = ['#bd805d', '#F7D358', 'green', '#7730bf', 'yellow', '#b873ff',
              '#ff664c', 'orange', 'pink', 'cyan']

    def __init__(self, master=None):
        super().__init__(master)
        self.student= '70205273'
        # y создаём экземпляр класса TowerOfHanoi
        self.tower = TowerOfHanoi(self.student)
