        self.canvas.pack(fill=BOTH, expand=1)
        # y сохраняем в кэше = self.student [max количество итераций, конечный
        #  список
        #  расположения дисков]
        self.cache = {'70205273': ['49245', [[], [87, 86, 85, 84, 83, 82, 81,
                                                  61, 58, 57, 56, 55, 54, 53,
                                                  52, 51, 46, 45, 44, 43, 42,
                                                  41, 32, 31, 27,
                                                  26, 25, 24, 23, 22, 21, 14,
                                                  13, 12, 11], [], [], [], [],
                                             [], [], []]]}

    def value_student(self):
        # y получаем 8-ми значное значение из поля ввода
        res = self.entry_8.get()
        # y проверяем 8-ми значное значение
        if self.validation_8_character_field(res):
            self.tower = TowerOfHanoi(res)
            self.student = res
            # y деактивируем кнопки, кроме кнопки "начало"
            self.activate_buttons(False)
        else:
            self.entry_8.delete(0, "end")
            self.entry_8.insert(0, 'Ошибка')

    def create_canvas_base(self):  # r создаём основание и 8 шпинделей
        # y основание под шпиндели
        self.canvas.create_rectangle(50, 740, 825, 725, fill=self.COLORS[0],
                                     width=3, outline="#bd5000")
        # y рисуем 8 вертикальных шпинделей
        for i, num in enumerate(range(8, 0, -1)):
            x1 = 100 + 95 * i
            self.canvas.create_rectangle(x1, 725, x1 + 10, 450,
                                         fill=self.COLORS[0], width=3,
                                         outline="#bd5000")
            # y указываем номера шпинделей
            self.canvas.create_text(x1 + 2, 726, text=str(num), fill='black',
                                    font='TkMenuFont, 9', anchor='nw')

    def create_canvas_disks(self, data):   # r отрисовываем диски
        for i, lst in  enumerate(data):
            for el, disk in enumerate(lst):  # y перебираем диски на шпинделе
                x0, y0 = self.POINTS[i][0], self.POINTS[i][1]
                half = disk // 2  # r вычисляем половину диска
                x0 -= half  # y вычисляем левую координату диска
                color = self.COLORS[disk % 10]
                # y отображаем диск
                self.canvas.create_rectangle(x0, y0 - el * 10, x0 + disk,
                                             y0 - (el + 1) * 10,
                                             fill=color, width=1,
                                             outline="#bd5000",
                                             tags="my_disk")
                # y отображаем номер диаметра диска
                self.canvas.create_text(x0 + half - 5, y0 - 10 - el * 10,
                                        text=disk, font='TkMenuFont, 7', anchor='nw',
                                        fill='black', tags="my_number_disk")

    def delete_disks(self): # r через теги удаляем только отрисованные диски
        self.canvas.delete("my_disk")
        self.canvas.delete("my_number_disk")
        self.canvas.delete("my_add_disk")
        self.canvas.delete("my_number_add_disk")

    def resetting_results(self): # r сбрасываем списки дисков и итерации на
        # r начальное  значение
        self.tower.updating_disks()
        self.tower.counter = 0

    def drawing_single_disk(self, num_disk, source, target):
        # r при нажатии кнопок ('П.1' ...'П.4') в результате которых из %
        #  вычисляется "дробная" (165.8),а не целочисленная (165) итерация
        #  прорисовываем один диск перемещаемый от одного шпинделя до другого
        # y вычисляем какое значение больше и если что корректируем его
        if source > target:
            source, target = target, source
        # y вычисляем координаты диска
        difference = self.POINTS[source][0] - self.POINTS[target][0]
        center = difference / 2 + self.POINTS[target][0]
        half = num_disk // 2 # y вычисляем половину диска
        x0 = center - half # y вычисляем левую координату диска
        y0 = 430
        x1 = x0 + num_disk # y вычисляем координаты правой части диска
        y1 = y0 + 10
        color = self.COLORS[num_disk % 10]
        # y отображаем диск
        self.canvas.create_rectangle(x0, y0, x1, y1,
                                     fill=color, width=1,
                                     outline="#bd5000",
                                     tags="my_add_disk")
        # y отображаем номер диаметра диска
        self.canvas.create_text(x0 + half - 5, y0 - 1,
                                text=num_disk, font='TkMenuFont, 7', anchor='nw',
                                fill='black', tags="my_number_add_disk")

    def validation_input_fields(self, input_str): # r валидация данных в полях
        # r ввода
        pattern = re.compile(r'^\d{1,2}$')
        return bool(pattern.match(input_str))

    def validation_8_character_field(self, input_8): #r валидация 8 чисел
        return re.match(r"^\d{8}$", input_8) is not None

    def button_start(self): # r отображаем начальную позицию дисков
        self.delete_disks()
        self.create_canvas_disks(self.tower.updating_disks())
        # y если в поле "Начальное значение" указано "Ошибка"
        if self.entry_8.get() == 'Ошибка':
            self.entry_8.delete(0, "end")
            self.entry_8.insert(0, self.student)
        self.iteration['text']='Итерация: 0'
        # y Активируем остальные кнопки после нажатия "Начало"
        self.activate_buttons()
        # y если кэш пустой то сохраняем конечный результат обсчёта дисков
        #  и max количества итераций в кэше
        if not self.cache.get(self.student):
            tmp = self.tower.go()
            self.cache[self.student] = [str(self.tower.counter), tmp]
        self.resetting_results()

    def button_end(self): # r отображаем конечную позицию дисков
        self.delete_disks()
        self.iteration['text'] = 'Итерация: ' + self.cache[self.student][0]
        self.create_canvas_disks(self.cache[self.student][1])
        self.resetting_results()

    def percentage_run(self, number): # r обрабатываем процент выполнения
        # r данных, полученных из полей ввода (entry_1, … entry_4)
        self.delete_disks()
        # y получаем заданный процент
        if number == 1:
            percentage = self.entry_1.get()
        elif number == 2:
            percentage = self.entry_2.get()
        elif number == 3:
            percentage = self.entry_3.get()
        else:
            percentage = self.entry_4.get()
        # y осуществляем валидацию введенных данных как 1 или 2 числа
        if not self.validation_input_fields(percentage):
            return
        # y берём max количество итераций из кэша
        iter_go = self.cache[self.student][0]
        # y получаем номер итерации от % выполнения и округляем его до
        #  трёх знаков после точки
        self.value_iter = round(int(iter_go) / 100 * float(percentage), 3)
        # y проверяем целое число или вещественное
        num = str(self.value_iter).split('.')
        if num[1] == "0": # y целое число
            # y Переводим номер итерации из float в int
            self.value_iter = int(self.value_iter)
            # y присваиваем значение (количество итераций от % выполнения)
            self.tower.percentage_counter = self.value_iter
            # y сбрасываем списки дисков и итерации на начальное значение
            self.resetting_results()
            # y запускаем процесс обсчета дисков
            self.tower.go()
            # y сохраняем текущее состояние дисков (в зависимости от %
            #  выполнения)
            tmp = self.tower.tmp_value[0]
            # y прорисовываем диски
            self.create_canvas_disks(tmp)
            # y изменяем метку с надписью "Итерация"
            self.iteration['text'] = 'Итерация: ' + str(self.value_iter)
        else:
            # y вещественное число округляем до целого в большую сторону
            value_iter_changed = math.ceil(self.value_iter) # y 745.754 => 746
            # y присваиваем значение (количество итераций от % выполнения)
            self.tower.percentage_counter = value_iter_changed
            # y сбрасываем списки дисков и итерации на начальное значение
            self.resetting_results()
            # y запускаем процесс обсчета дисков
            self.tower.go()
            # y сохраняем текущее состояние дисков (в зависимости от %
            #  выполнения)
            tmp_list_disks = self.tower.tmp_value[0]
            # y Получаем номер диска для отображения его визуального
            #  перемещения
            tmp_disk = self.tower.tmp_value[1]
            # y Находим диск по номеру и удаляем его из списка
            for i in tmp_list_disks:
                if i.count(tmp_disk):
                    i.remove(tmp_disk)
            # y прорисовываем диски
            self.create_canvas_disks(tmp_list_disks)
            # y получаем source, target
            source = self.tower.tmp_value[2]
            target = self.tower.tmp_value[3]
            # y прорисовываем дополнительный "передвигаемый" диск
            self.drawing_single_disk(tmp_disk, source, target)
            # y изменяем метку с надписью "Итерация"
            self.iteration['text'] = 'Итерация: ' + str(self.value_iter)

        # y очищаем переменную self.tower.tmp_value
        self.tower.tmp_value.clear()
        logger.info(f'Сброс значений')

